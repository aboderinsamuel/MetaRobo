# Meta Muse Spark powers the Control Lab's modeler and explainer. Without live calls the lab
# still works, using the offline physics library and rule-based advisor.
MODEL_API_KEY=
# Live Meta API calls only happen when this is 1. Leave it at 0 while developing to save credit.
META_LIVE=0
# Optional: model id (default muse-spark-1.3) and daily spend cap in USD (default 1).
META_TEXT_MODEL=
META_DAILY_BUDGET_USD=1

# FastAPI backend for the arm / rover builder (see ../README.md).
BACKEND_URL=http://127.0.0.1:8000
